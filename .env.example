# Backend API URL. Leave unset for local dev -- npm run dev proxies /api to
# a local backend on :8080 (see vite.config.ts), and the deployed build's
# /api is rewritten to Railway by vercel.json, so a same-origin relative
# path is already correct in both cases. Only set this to explicitly point
# at a different backend, e.g. to test a local frontend against the live
# Railway API instead of one running on :8080:
# VITE_API_URL=https://agriflow-api-production.up.railway.app

# NEAR Intents 1-Click Platform Configuration
VITE_NEAR_PLATFORM_ADDRESS=agriflow.near
VITE_NEAR_INTENTS_API_KEY=
