DATABASE_URL=postgres://agriflow:agriflow@localhost:5432/agriflow
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRY_HOURS=24
SERVER_ADDR=0.0.0.0:8080
RUST_LOG=agriflow_api=debug,tower_http=debug,sqlx=warn

# Required to register an admin via POST /api/auth/register (sent as the
# X-Admin-Registration-Key header). Leave unset to disable admin signup.
ADMIN_REGISTRATION_KEY=

# Password for the seeded default admin account (admin@agriflow.africa),
# read only by `cargo run --bin seed_admin` -- not read by the server
# itself. No default; the seed script refuses to run without it.
ADMIN_SEED_PASSWORD=

# Welcome emails via Resend (https://resend.com). Leave unset to skip sending.
RESEND_API_KEY=
# Must be on a domain verified in Resend; the default test sender below only
# delivers to your own Resend account's address.
EMAIL_FROM=AgriFlow <onboarding@resend.dev>

# Bachs.io payments (https://docs.bachs.io). Leave unset to disable Bachs
# checkout. sk_sandbox_ keys hit sandbox-api.bachs.io, sk_live_ keys hit
# api.bachs.io. Never commit real values -- set them in Railway / your .env.
BACHS_SECRET_KEY=
# Signing secret (whsec_...) from the webhook endpoint in the Bachs developer
# portal. Point that endpoint at <API origin>/api/webhooks/bachs.
BACHS_WEBHOOK_SECRET=

# Public origin of the React app (no trailing slash). Bachs checkout only
# redirects back to this origin. Bachs rejects localhost redirect URLs, so
# local testing still needs a public origin here (e.g. the deployed app).
FRONTEND_BASE_URL=https://agri-flowmvp.vercel.app
